# Copy these VITE_ entries to .env.local. Never use a service-role/secret key here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-or-anon-key

# Copy these server-only entries to repository-root .env (not .env.local).
# Supabase CLI resolves config.toml env(...) references from that file.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-web-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-web-client-secret
